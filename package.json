{
  "name": "autonomous-multi-agent-app-builder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^6.1.1",
    "chart.js": "^4.5.1",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^13.4.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
